# Copier vers .env (jamais versionné) et remplacer chaque « change-me ».

# PostgreSQL
POSTGRES_USER=darlen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=darlen

# Garage (stockage objet S3)
# openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=change-me
# Renseignés après « garage key create » (voir deploy/README.md)
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=darlen

# Darlen
DARLEN_TIMEZONE=Europe/Paris
